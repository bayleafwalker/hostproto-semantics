{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hostproto.invalid/schemas/evidence-ref.schema.json",
  "title": "HostProto evidence reference v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ref",
    "surface_class",
    "media_type",
    "size_bytes"
  ],
  "properties": {
    "schema_version": {
      "const": "hostproto.evidence-ref/v1"
    },
    "ref": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "surface_class": {
      "enum": [
        "raw",
        "normalized",
        "contract",
        "diagnostic",
        "redacted"
      ]
    },
    "media_type": {
      "type": "string",
      "minLength": 1
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "path": {
      "type": "string",
      "description": "Location inside its evidence bundle only."
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      "description": "Raw records a normalized artifact was derived from."
    }
  },
  "description": "Content-addressed. A reference never implies authority to retrieve data outside the evidence bundle it belongs to."
}
